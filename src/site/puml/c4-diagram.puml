' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists, update it to accurately reflect the current architecture, key components, and their relationships.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems: `mongodb`, `genaiProvider`, `fileSystem`; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

title Bindex Core - C4 Component Diagram

Person(user, "Developer / Build Process", "Uses Bindex tools to retrieve, recommend, and register library metadata")
System_Ext(fileSystem, "Working Directory", "Provides local bindex.json descriptors for registration and lookup")
System_Ext(genaiProvider, "GenAI Provider", "Classifies project requests and creates classification embeddings")
System_Ext(mongodb, "MongoDB", "Persists Bindex documents and supports vector search")

System_Boundary(bindexCore, "Bindex Core") {
  Component(bindexFunctionTools, "BindexFunctionTools", "Java", "Exposes retrieval, recommendation, registration, schema, and prompt tools")
  Component(graphqlJsonFilter, "GraphqlJsonFilter", "Java", "Projects requested top-level fields from serialized Bindex metadata")
  Component(picker, "Picker", "Java", "Builds GenAI classifications and embeddings, then coordinates registration and recommendations")
  Component(repository, "BindexRepository", "Java interface", "Defines Bindex lookup, persistence, and semantic-search operations")
  Component(mongoRepository, "MongoBindexRepository", "Java / MongoDB Driver", "Implements repository operations, document persistence, and vector-search queries")
}

Rel(user, bindexFunctionTools, "Invokes")
Rel(bindexFunctionTools, fileSystem, "Reads descriptors from")
Rel(bindexFunctionTools, graphqlJsonFilter, "Filters metadata with")
Rel(bindexFunctionTools, picker, "Delegates recommendations and registration to")
Rel(bindexFunctionTools, repository, "Retrieves metadata through")
Rel(bindexFunctionTools, mongoRepository, "Creates the default implementation")
Rel(picker, genaiProvider, "Requests classifications and embeddings from")
Rel(picker, repository, "Saves and searches Bindex records through")
Rel(mongoRepository, repository, "Implements")
Rel(mongoRepository, mongodb, "Stores documents and runs vector searches in")

SHOW_LEGEND()
@enduml
